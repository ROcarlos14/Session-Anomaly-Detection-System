# ============================================================
# Browser-Based Anomaly Detection System — Environment Config
# Copy this to .env and fill in your values
# ============================================================

# PostgreSQL (Docker local dev)
DATABASE_URL=postgresql://anomaly_user:anomaly_password@localhost:5432/anomaly_detection_development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=anomaly_user
POSTGRES_PASSWORD=anomaly_password
POSTGRES_DB=anomaly_detection_development

# Redis (Docker local dev)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis Stream names
STREAM_RAW_TELEMETRY=raw:telemetry
STREAM_ML_RESULTS=ml:results
STREAM_CPP_RESULTS=cpp:results
STREAM_ALERTS=alerts:aggregated

# Rails
RAILS_ENV=development
RAILS_SECRET_KEY_BASE=change_me_in_production_use_rails_secret
RAILS_MASTER_KEY=

# Dashboard
DASHBOARD_HOST=localhost
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000

# Alert thresholds
ALERT_THRESHOLD_LOW=0.40
ALERT_THRESHOLD_MEDIUM=0.60
ALERT_THRESHOLD_HIGH=0.80
ALERT_THRESHOLD_CRITICAL=0.90

# Orchestrator scoring weights
ORCHESTRATOR_ML_WEIGHT=0.60
ORCHESTRATOR_CPP_WEIGHT=0.40

# Python ML Engine
ML_ENGINE_CONSUMER_GROUP=ml-engine
ML_ENGINE_CONSUMER_NAME=ml-worker-1
ML_MODEL_RETRAIN_INTERVAL_HOURS=24

# C++ Engine
CPP_ENGINE_CONSUMER_GROUP=cpp-engine
CPP_ENGINE_CONSUMER_NAME=cpp-worker-1
CPP_WINDOW_SIZE_SECONDS=30
CPP_MAX_REQUESTS_PER_SECOND=50
CPP_MAX_DOMAINS_PER_MINUTE=30
CPP_MAX_REDIRECT_CHAIN=3
CPP_MAX_XHR_ERROR_RATE=0.20
CPP_MAX_DOM_MUTATIONS_PER_SECOND=50

# Supabase (for production — leave blank for local dev)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
